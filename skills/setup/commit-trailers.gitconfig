[hook "committrailers"]
	event = commit-msg
	command = "command -v commit-trailers >/dev/null || { keys=$(git config --get-all dev.trailer.provenance | sed 's/[][\\.*^$+?(){}|/]/\\\\&/g' | paste -sd '|' -); [ -z \"$keys\" ] || { msg=$1; PROVENANCE=\"^($keys): \" awk 'BEGIN { provenance = ENVIRON[\"PROVENANCE\"] } { line[++n] = $0 } END { last = n; while (last > 0 && (line[last] ~ /^[[:space:]]*$/ || line[last] ~ /^#/)) last--; attr_first = last; while (attr_first > 0 && tolower(line[attr_first]) ~ /^(co-authored-by|claude-session): /) attr_first--; if (attr_first == last || attr_first == 0 || line[attr_first] !~ /^[[:space:]]*$/) fix = 0; else { prov_last = attr_first; while (prov_last > 0 && line[prov_last] ~ /^[[:space:]]*$/) prov_last--; prov_first = prov_last; while (prov_first > 0 && line[prov_first] ~ provenance) prov_first--; fix = (prov_first < prov_last && prov_first > 0 && line[prov_first] ~ /^[[:space:]]*$/) } for (i = 1; i <= n; i++) if (!(fix && i > prov_last && i <= attr_first)) print line[i]; exit fix ? 0 : 3 }' \"$msg\" >\"$msg.joined\"; join_status=$?; if [ \"$join_status\" = 0 ]; then mv \"$msg.joined\" \"$msg\" || echo \"commit-trailers: could not rewrite the commit message to join its trailers\" >&2; elif [ \"$join_status\" != 3 ]; then echo \"commit-trailers: could not join the trailer paragraphs (awk exit $join_status)\" >&2; fi; rm -f \"$msg.joined\"; }; exit 0; }; commit-trailers \"$@\""
[dev "trailer"]
	provenance = Bead
	provenance = Refs
