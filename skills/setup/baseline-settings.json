{
  "permissions": {
    "allow": [
      "Bash(bd *)"
    ],
    "ask": [
      "Bash(git reset --hard*)",
      "Bash(git -C * reset --hard*)",
      "Bash(git clean*)",
      "Bash(git -C * clean*)",
      "Bash(git stash drop*)",
      "Bash(git -C * stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git -C * stash clear*)",
      "Bash(bd dolt push*)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Read(~/.kube/**)",
      "Edit(~/.kube/**)",
      "Read(~/.netrc)",
      "Edit(~/.netrc)",
      "Read(**/.env)",
      "Edit(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env.*)",
      "Read(**/.beads-credential-key)",
      "Edit(**/.beads-credential-key)",
      "Read(~/.config/gh/**)",
      "Edit(~/.config/gh/**)",
      "Read(~/.config/tea/**)",
      "Edit(~/.config/tea/**)",
      "Read(~/.docker/config.json)",
      "Edit(~/.docker/config.json)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "excludedCommands": [
      "git push*",
      "git -C * push*",
      "git fetch*",
      "git -C * fetch*",
      "git pull*",
      "git -C * pull*",
      "bd dolt push*",
      "bd dolt pull*"
    ],
    "filesystem": {
      "allowRead": [
        "~/.beads",
        "~/.dolt",
        "~/.config/bd"
      ],
      "allowWrite": [
        "~/.beads",
        "~/.dolt",
        "~/.config/bd"
      ]
    }
  }
}
